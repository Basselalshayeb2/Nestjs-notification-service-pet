{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/nestjs-notification-service-pet/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/nestjs-notification-service-pet/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/nestjs-notification-service-pet",
  "projects": {
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "consumer-service": {
      "type": "application",
      "root": "apps/consumer-service",
      "entryFile": "main",
      "sourceRoot": "apps/consumer-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/consumer-service/tsconfig.app.json"
      }
    },
    "contracts": {
      "type": "library",
      "root": "libs/contracts",
      "entryFile": "index",
      "sourceRoot": "libs/contracts/src",
      "compilerOptions": {
        "tsConfigPath": "libs/contracts/tsconfig.lib.json"
      }
    },
    "nestjs-notification-service-pet": {
      "type": "application",
      "root": "apps/nestjs-notification-service-pet",
      "entryFile": "main",
      "sourceRoot": "apps/nestjs-notification-service-pet/src",
      "compilerOptions": {
        "tsConfigPath": "apps/nestjs-notification-service-pet/tsconfig.app.json"
      }
    },
    "producer-service": {
      "type": "application",
      "root": "apps/producer-service",
      "entryFile": "main",
      "sourceRoot": "apps/producer-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/producer-service/tsconfig.app.json"
      }
    },
    "telegram-service": {
      "type": "application",
      "root": "apps/telegram-service",
      "entryFile": "main",
      "sourceRoot": "apps/telegram-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/telegram-service/tsconfig.app.json"
      }
    }
  }
}